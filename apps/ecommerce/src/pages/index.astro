---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,700;1,600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-main: #fbfbfa;
      --bg-surface: #ffffff;
      --bg-warm: #f7f5ef;
      --text-main: #1c1917;
      --text-muted: #78716c;
      --text-subtle: #a8a29e;
      --primary: #d97706;
      --primary-hover: #b45309;
      --primary-light: #fef3c7;
      --accent: #ea580c;
      --border-light: #ede8df;
      --border-card: #f1ede4;
      --shadow-sm: 0 2px 8px rgba(28, 25, 23, 0.04);
      --shadow-md: 0 8px 24px -4px rgba(28, 25, 23, 0.08);
      --shadow-lg: 0 20px 40px -8px rgba(28, 25, 23, 0.12);
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 22px;
      --radius-full: 9999px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-main);
      color: var(--text-main);
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* Header Nav */
    header.site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-light);
    }
    .header-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0.9rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text-main);
    }
    .brand-icon {
      font-size: 1.85rem;
      line-height: 1;
    }
    .brand-name {
      font-size: 1.35rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
    }
    .brand-name span {
      color: var(--primary);
    }
    .brand-sub {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      font-weight: 700;
      display: block;
      margin-top: -2px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.95rem;
      transition: color 0.2s;
    }
    .nav-links a:hover {
      color: var(--primary);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .btn-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 1rem;
      border: 1px solid var(--border-light);
      background: #ffffff;
      color: var(--text-main);
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s;
    }
    .btn-outline:hover {
      border-color: var(--primary);
      color: var(--primary);
      transform: translateY(-1px);
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.3rem;
      background: linear-gradient(135deg, #d97706 0%, #b45309 100%);
      color: #ffffff;
      border-radius: var(--radius-full);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.3);
      transition: all 0.25s;
      border: none;
      cursor: pointer;
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 22px rgba(217, 119, 6, 0.4);
    }

    /* Hero Section */
    .hero-section {
      position: relative;
      padding: 5rem 1.5rem 4rem;
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3.5rem;
    }
    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--primary-light);
      color: #92400e;
      padding: 0.35rem 0.9rem;
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 700;
      margin-bottom: 1.25rem;
      border: 1px solid rgba(217, 119, 6, 0.2);
    }
    .hero-title {
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -0.03em;
      color: var(--text-main);
      margin-bottom: 1.3rem;
    }
    .hero-title span.highlight {
      background: linear-gradient(135deg, #d97706 30%, #ea580c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .hero-lead {
      font-size: 1.15rem;
      line-height: 1.65;
      color: var(--text-muted);
      max-width: 580px;
      margin-bottom: 2.2rem;
    }
    .hero-buttons {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border-light);
    }
    .stat-number {
      font-size: 1.75rem;
      font-weight: 800;
      color: var(--text-main);
    }
    .stat-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .hero-image-wrap {
      position: relative;
    }
    .hero-card-featured {
      background: #ffffff;
      border-radius: var(--radius-lg);
      padding: 1.25rem;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border-card);
      position: relative;
      overflow: hidden;
      transform: rotate(-1deg);
      transition: transform 0.3s;
    }
    .hero-card-featured:hover {
      transform: rotate(0deg) scale(1.02);
    }
    .hero-card-img {
      width: 100%;
      height: 380px;
      object-fit: cover;
      border-radius: var(--radius-md);
    }
    .hero-floating-pill {
      position: absolute;
      bottom: 2rem;
      left: 2rem;
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      padding: 0.75rem 1.25rem;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-md);
      display: flex;
      align-items: center;
      gap: 0.75rem;
      border: 1px solid var(--border-light);
    }
    .floating-star {
      font-size: 1.4rem;
    }
    .floating-text strong {
      display: block;
      font-size: 0.9rem;
      color: var(--text-main);
    }
    .floating-text span {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    /* Catalog Section */
    .catalog-section {
      padding: 5rem 1.5rem;
      max-width: 1240px;
      margin: 0 auto;
    }
    .section-header {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 3rem;
    }
    .section-tag {
      display: inline-block;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 0.15em;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 0.6rem;
    }
    .section-title {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: var(--text-main);
      margin-bottom: 0.9rem;
    }
    .section-desc {
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.6;
    }

    /* Filter Pills */
    .filter-tabs {
      display: flex;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .filter-btn {
      padding: 0.55rem 1.25rem;
      background: #ffffff;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-full);
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: var(--text-main);
      color: #ffffff;
      border-color: var(--text-main);
    }

    /* Burger Cards Grid */
    .burgers-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 2rem;
    }
    .burger-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
      position: relative;
    }
    .burger-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lg);
      border-color: rgba(217, 119, 6, 0.3);
    }
    .card-img-wrap {
      position: relative;
      height: 220px;
      overflow: hidden;
      background: #f3efe6;
    }
    .card-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .burger-card:hover .card-img {
      transform: scale(1.06);
    }
    .badge-specialty {
      position: absolute;
      top: 1rem;
      left: 1rem;
      background: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(6px);
      color: #1c1917;
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 700;
      border: 1px solid rgba(0, 0, 0, 0.06);
      box-shadow: 0 4px 10px rgba(0,0,0,0.06);
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .badge-rating {
      position: absolute;
      bottom: 1rem;
      right: 1rem;
      background: rgba(28, 25, 23, 0.85);
      color: #fbbf24;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      font-size: 0.75rem;
      font-weight: 700;
    }

    .card-content {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .card-category {
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-subtle);
      font-weight: 700;
      margin-bottom: 0.35rem;
    }
    .card-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.4rem;
      line-height: 1.3;
    }
    .specialty-tier-pill {
      display: inline-block;
      font-size: 0.74rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
      margin-bottom: 0.85rem;
      width: fit-content;
    }
    .card-tagline {
      font-size: 0.88rem;
      color: var(--text-muted);
      line-height: 1.5;
      margin-bottom: 1.25rem;
      flex: 1;
    }
    .card-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 1rem;
      border-top: 1px solid var(--border-light);
    }
    .card-price {
      font-size: 1.45rem;
      font-weight: 800;
      color: var(--text-main);
    }
    .card-price small {
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text-muted);
    }
    .btn-details {
      background: #ffffff;
      color: var(--text-main);
      border: 1px solid var(--border-light);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      transition: all 0.2s;
    }
    .btn-details:hover {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      transform: translateY(-1px);
    }

    /* Modal Backdrop & Dialog */
    .modal-backdrop {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(28, 25, 23, 0.6);
      backdrop-filter: blur(8px);
      z-index: 100;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .modal-backdrop.open {
      display: flex;
    }
    .modal-card {
      background: #ffffff;
      border-radius: var(--radius-lg);
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0,0,0,0.25);
      position: relative;
      animation: modalIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    @keyframes modalIn {
      from { opacity: 0; transform: scale(0.95) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .modal-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid var(--border-light);
      border-radius: 50%;
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      cursor: pointer;
      color: var(--text-main);
      z-index: 10;
      transition: all 0.2s;
    }
    .modal-close:hover {
      background: var(--text-main);
      color: #ffffff;
    }
    .modal-img {
      width: 100%;
      height: 280px;
      object-fit: cover;
    }
    .modal-body {
      padding: 2rem;
    }
    .modal-tier {
      display: inline-block;
      padding: 0.3rem 0.8rem;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }
    .modal-title {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-main);
      margin-bottom: 0.5rem;
    }
    .modal-desc {
      color: var(--text-muted);
      line-height: 1.6;
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }
    .modal-ingredients {
      background: var(--bg-warm);
      border-radius: var(--radius-md);
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      border: 1px solid var(--border-card);
    }
    .modal-ingredients h4 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-main);
      margin-bottom: 0.75rem;
    }
    .ingredients-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .ingredient-tag {
      background: #ffffff;
      border: 1px solid var(--border-light);
      padding: 0.35rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-main);
    }
    .modal-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
      text-align: center;
    }
    .spec-box {
      background: #fdfdfd;
      border: 1px solid var(--border-light);
      padding: 0.75rem;
      border-radius: var(--radius-sm);
    }
    .spec-val {
      font-size: 1rem;
      font-weight: 800;
      color: var(--primary);
    }
    .spec-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 600;
    }
    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border-light);
    }
    .modal-price {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--text-main);
    }

    /* Benefits section */
    .benefits-section {
      background: var(--bg-warm);
      padding: 5rem 1.5rem;
      border-top: 1px solid var(--border-light);
      border-bottom: 1px solid var(--border-light);
    }
    .benefits-grid {
      max-width: 1240px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
    }
    .benefit-card {
      background: #ffffff;
      padding: 2rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-card);
      box-shadow: var(--shadow-sm);
    }
    .benefit-icon {
      font-size: 2.25rem;
      margin-bottom: 1rem;
      display: inline-block;
    }
    .benefit-title {
      font-size: 1.2rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
      color: var(--text-main);
    }
    .benefit-text {
      color: var(--text-muted);
      font-size: 0.92rem;
      line-height: 1.6;
    }

    /* Cross Navigation Banner */
    .banner-ecosystem {
      max-width: 1240px;
      margin: 5rem auto;
      padding: 0 1.5rem;
    }
    .ecosystem-box {
      background: linear-gradient(135deg, #1c1917 0%, #292524 100%);
      color: #ffffff;
      border-radius: var(--radius-lg);
      padding: 3.5rem;
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      align-items: center;
      gap: 2.5rem;
      box-shadow: var(--shadow-lg);
    }
    .ecosystem-box h3 {
      font-size: 2.2rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 1rem;
    }
    .ecosystem-box p {
      color: #d6d3d1;
      font-size: 1.05rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }
    .ecosystem-links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .app-link-card {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 1.25rem 1.5rem;
      border-radius: var(--radius-md);
      display: flex;
      align-items: center;
      justify-content: space-between;
      text-decoration: none;
      color: #ffffff;
      transition: all 0.25s;
    }
    .app-link-card:hover {
      background: rgba(255, 255, 255, 0.16);
      transform: translateX(4px);
      border-color: var(--primary);
    }
    .app-link-info strong {
      display: block;
      font-size: 1.05rem;
    }
    .app-link-info span {
      font-size: 0.8rem;
      color: #a8a29e;
    }

    /* Footer */
    footer.site-footer {
      background: #ffffff;
      border-top: 1px solid var(--border-light);
      padding: 3.5rem 1.5rem 2rem;
    }
    .footer-container {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid var(--border-light);
    }
    .footer-copy {
      max-width: 1240px;
      margin: 1.5rem auto 0;
      text-align: center;
      font-size: 0.85rem;
      color: var(--text-subtle);
    }

    @media (max-width: 900px) {
      .hero-section {
        grid-template-columns: 1fr;
        padding-top: 2.5rem;
      }
      .ecosystem-box {
        grid-template-columns: 1fr;
        padding: 2rem;
      }
      .nav-links {
        display: none;
      }
    }
  </style>
</head>
<body>

  <!-- Header Nav -->
  <header class="site-header">
