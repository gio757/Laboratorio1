---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="FAST FOOD - Tasty Food Happy Mood. Descubre nuestros Combo Offers, Meals completos, More Fast Food y catálogo de 10 variantes gourmet con despacho ultrarrápido a tu puerta." />
  
  <!-- Google Fonts: Bebas Neue, Caveat, Oswald, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@600;700&family=Oswald:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-dark: #0a0a0c;
      --bg-chalkboard: #111114;
      --bg-card: #15151a;
      --bg-card-hover: #1e1e24;
      --bg-accent: #1e1810;
      
      --red-primary: #dc2626;
      --red-dark: #991b1b;
      --red-bright: #ef4444;
      --red-glow: rgba(220, 38, 38, 0.45);
      
      --yellow-gold: #f59e0b;
      --yellow-bright: #fbbf24;
      --yellow-light: #fef08a;
      --yellow-dark: #b45309;
      --yellow-glow: rgba(245, 158, 11, 0.35);

      --green-veg: #16a34a;
      --green-bright: #22c55e;
      --orange-meal: #ea580c;
      --emerald-meal: #059669;

      --text-white: #ffffff;
      --text-cream: #fef3c7;
      --text-muted: #9ca3af;
      --text-dark: #121212;

      --font-display: 'Bebas Neue', 'Oswald', sans-serif;
      --font-script: 'Caveat', cursive;
      --font-body: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: var(--font-body);
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 15% 10%, rgba(220, 38, 38, 0.22) 0%, transparent 45%),
        radial-gradient(circle at 85% 15%, rgba(245, 158, 11, 0.18) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(220, 38, 38, 0.08) 0%, transparent 60%),
        radial-gradient(circle at 20% 85%, rgba(245, 158, 11, 0.12) 0%, transparent 40%),
        linear-gradient(180deg, #09090b 0%, #121216 50%, #0a0a0d 100%);
      background-attachment: fixed;
      color: var(--text-white);
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* Top Announcement Bar */
    .top-announcement {
      background: linear-gradient(90deg, #991b1b 0%, #dc2626 50%, #b45309 100%);
      color: #ffffff;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.5rem 1rem;
      text-align: center;
      letter-spacing: 0.05em;
      border-bottom: 2px solid var(--yellow-bright);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
    }
    .top-announcement span {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .top-announcement a {
      color: var(--yellow-light);
      text-decoration: underline;
      font-weight: 800;
    }

    /* Header Nav */
    header.site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(14, 14, 18, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 2px solid rgba(245, 158, 11, 0.25);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    }
    .header-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0.85rem 1.5rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
    }
    .brand-icon-wrap {
      background: linear-gradient(135deg, #dc2626, #b45309);
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: 0 0 16px var(--red-glow);
      border: 1px solid var(--yellow-bright);
    }
    .brand-text-block {
      display: flex;
      flex-direction: column;
    }
    .brand-title {
      font-family: var(--font-display);
      font-size: 2.1rem;
      line-height: 0.95;
      letter-spacing: 0.04em;
      color: #ffffff;
      text-shadow: 2px 2px 0px #000000;
    }
    .brand-title span {
      color: var(--yellow-bright);
      text-shadow: 0 0 10px rgba(245, 158, 11, 0.6);
    }
    .brand-tagline {
      font-family: var(--font-script);
      font-size: 1.15rem;
      color: #fbbf24;
      line-height: 1;
      letter-spacing: 0.02em;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      list-style: none;
    }
    .nav-links a {
      text-decoration: none;
      color: #e5e7eb;
      font-weight: 700;
      font-size: 0.92rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      transition: all 0.2s;
      position: relative;
    }
    .nav-links a:hover {
      color: var(--yellow-bright);
      text-shadow: 0 0 8px rgba(245, 158, 11, 0.5);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }
    .btn-nav-outline {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 0.9rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 700;
