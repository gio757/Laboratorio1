      background: rgba(245, 158, 11, 0.12);
      transform: translateY(-2px);
    }
    .btn-nav-hotline {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.55rem 1.1rem;
      background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
      color: #ffffff;
      border: 2px solid var(--yellow-bright);
      border-radius: 9999px;
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      box-shadow: 0 0 16px var(--red-glow);
      transition: all 0.25s;
    }
    .btn-nav-hotline:hover {
      transform: scale(1.05) translateY(-2px);
      box-shadow: 0 0 24px rgba(220, 38, 38, 0.7);
    }

    /* Common Section Header Banners (Like poster ribbons) */
    .section-ribbon-wrap {
      text-align: center;
      margin: 0 auto 2.5rem;
      position: relative;
    }
    .ribbon-banner {
      display: inline-flex;
      align-items: center;
      gap: 0.8rem;
      background: linear-gradient(90deg, #d97706 0%, #fbbf24 50%, #d97706 100%);
      color: #121212;
      font-family: var(--font-display);
      font-size: 2rem;
      letter-spacing: 0.08em;
      padding: 0.35rem 2.8rem;
      border-radius: 6px;
      box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4), inset 0 2px 0 rgba(255, 255, 255, 0.4);
      position: relative;
      text-shadow: 1px 1px 0px rgba(255, 255, 255, 0.3);
      clip-path: polygon(15px 0%, calc(100% - 15px) 0%, 100% 50%, calc(100% - 15px) 100%, 15px 100%, 0% 50%);
    }
    .ribbon-sub {
      color: var(--text-muted);
      font-size: 0.95rem;
      margin-top: 0.75rem;
      font-weight: 500;
    }

    /* Hero Section (Faithful to poster top) */
    .hero-section {
      max-width: 1280px;
      margin: 0 auto;
      padding: 3.5rem 1.5rem 4rem;
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: center;
      gap: 3.5rem;
      position: relative;
    }
    .hero-script-tag {
      font-family: var(--font-script);
      font-size: 2.2rem;
      color: var(--yellow-bright);
      transform: rotate(-3deg);
      display: inline-block;
      margin-bottom: 0.2rem;
      text-shadow: 0 0 12px rgba(245, 158, 11, 0.4);
    }
    .hero-main-title {
      font-family: var(--font-display);
      font-size: clamp(4.5rem, 9vw, 8.5rem);
      line-height: 0.86;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
      user-select: none;
    }
    .hero-main-title .word-fast {
      color: #ffffff;
      display: block;
      text-shadow: 4px 6px 0px #000000, 0 0 20px rgba(255, 255, 255, 0.3);
    }
    .hero-main-title .word-food {
      color: #facc15;
      display: block;
      text-shadow: 4px 6px 0px #b91c1c, 0 0 30px rgba(245, 158, 11, 0.7);
      background: linear-gradient(180deg, #fef08a 0%, #eab308 60%, #ca8a04 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(4px 6px 0px #991b1b);
    }

    .hero-tagline-callout {
      background: rgba(220, 38, 38, 0.16);
      border-left: 4px solid var(--red-bright);
      padding: 0.9rem 1.25rem;
      border-radius: 0 12px 12px 0;
      margin-bottom: 1.75rem;
      max-width: 580px;
    }
    .hero-tagline-callout p {
      font-size: 1.05rem;
      color: #f3f4f6;
      line-height: 1.5;
    }
    .hero-telugu-hint {
      font-size: 0.88rem;
      color: var(--yellow-bright);
      font-weight: 700;
      margin-top: 0.35rem;
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* Hotline Banner with Megaphone */
    .hero-hotline-box {
      display: inline-flex;
      align-items: center;
      gap: 1.25rem;
      background: linear-gradient(135deg, #1f1f26 0%, #17171d 100%);
      border: 2px dashed var(--yellow-bright);
      padding: 0.9rem 1.6rem;
      border-radius: 16px;
      margin-bottom: 2.2rem;
      box-shadow: 0 12px 30px rgba(0,0,0,0.5);
    }
    .hotline-megaphone {
      font-size: 2.6rem;
      animation: wobble 2.5s infinite ease-in-out;
    }
    @keyframes wobble {
      0%, 100% { transform: rotate(0deg); }
      15% { transform: rotate(-14deg); }
      30% { transform: rotate(12deg); }
      45% { transform: rotate(-8deg); }
      60% { transform: rotate(4deg); }
      75% { transform: rotate(0deg); }
    }
    .hotline-text-wrap {
      display: flex;
      flex-direction: column;
    }
    .hotline-label {
      font-family: var(--font-display);
      font-size: 1.25rem;
      color: var(--yellow-bright);
      letter-spacing: 0.06em;
      line-height: 1;
    }
    .hotline-phone-pill {
      font-family: var(--font-display);
      font-size: 2.4rem;
      line-height: 1;
      letter-spacing: 0.05em;
      color: #ffffff;
      background: linear-gradient(90deg, #dc2626, #b91c1c);
      padding: 0.2rem 1rem;
      border-radius: 9999px;
      margin-top: 0.3rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 0 18px var(--red-glow);
      text-decoration: none;
      border: 1px solid rgba(255, 255, 255, 0.3);
    }
    .hotline-phone-pill:hover {
      transform: scale(1.03);
      box-shadow: 0 0 25px rgba(220, 38, 38, 0.8);
    }

    .hero-cta-buttons {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2rem;
    }
    .btn-hero-red {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
      color: #ffffff;
      font-family: var(--font-display);
      font-size: 1.45rem;
      letter-spacing: 0.05em;
      padding: 0.85rem 2rem;
      border-radius: 12px;
      text-decoration: none;
      border: 2px solid var(--yellow-bright);
      box-shadow: 0 8px 24px var(--red-glow);
      transition: all 0.25s;
      cursor: pointer;
    }
    .btn-hero-red:hover {
      transform: translateY(-3px) scale(1.02);
      box-shadow: 0 12px 30px rgba(220, 38, 38, 0.7);
    }
    .btn-hero-gold {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: transparent;
      color: var(--yellow-bright);
      font-family: var(--font-display);
      font-size: 1.35rem;
      letter-spacing: 0.05em;
      padding: 0.85rem 1.8rem;
      border-radius: 12px;
      text-decoration: none;
      border: 2px solid var(--yellow-bright);
      transition: all 0.25s;
    }
    .btn-hero-gold:hover {
      background: rgba(245, 158, 11, 0.15);
      transform: translateY(-2px);
      box-shadow: 0 0 20px var(--yellow-glow);
    }

    /* Hero Right Poster Showcase */
    .hero-poster-showcase {
      position: relative;
    }
    .hero-showcase-frame {
      position: relative;
      background: linear-gradient(135deg, #1b1b22 0%, #0f0f14 100%);
      border: 3px solid var(--yellow-bright);
      border-radius: 24px;
      padding: 1.25rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), 0 0 35px rgba(245, 158, 11, 0.25);
    }
    .hero-showcase-img {
      width: 100%;
      height: 420px;
      object-fit: cover;
      border-radius: 16px;
      display: block;
    }
    .hero-poster-badge-top {
      position: absolute;
      top: -1.2rem;
      right: 1.5rem;
      background: #dc2626;
      color: #ffffff;
      border: 2px solid var(--yellow-bright);
      font-family: var(--font-display);
      font-size: 1.3rem;
      letter-spacing: 0.06em;
      padding: 0.4rem 1.2rem;
      border-radius: 9999px;
      box-shadow: 0 6px 18px rgba(0,0,0,0.5);
      transform: rotate(4deg);
    }
    .hero-poster-badge-goodlife {
      position: absolute;
      bottom: 2rem;
      right: -1rem;
      background: rgba(18, 18, 22, 0.95);
      border: 2px solid var(--yellow-bright);
      border-radius: 16px;
      padding: 0.9rem 1.4rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.7);
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
    .goodlife-script {
      font-family: var(--font-script);
      font-size: 1.7rem;
      line-height: 1;
      color: var(--yellow-bright);
    }
    .goodlife-bold {
      font-family: var(--font-display);
      font-size: 1.3rem;
      letter-spacing: 0.05em;
      color: #ffffff;
      line-height: 1;
    }

    /* Section 1: COMBO OFFERS */
    .combos-section {
      padding: 4.5rem 1.5rem;
      max-width: 1280px;
      margin: 0 auto;
    }
    .combos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
    }
    .combo-card {
      background: #141418;
      border: 2px dashed rgba(245, 158, 11, 0.65);
      border-radius: 18px;
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
