          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Catalog Section -->
  <section id="catalogo" class="catalog-section">
    <div class="section-header">
      <span class="section-tag">Colección Exclusiva</span>
      <h2 class="section-title">Catálogo de 10 Variantes Destacadas</h2>
      <p class="section-desc">
        Descubre nuestras hamburguesas clásicas perfeccionadas y especialidades reservadas. Cada una clasificada con su nivel de especialidad culinaria y precio garantizado.
      </p>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
      <button class="filter-btn active" data-filter="all">Todas las Variantes (10)</button>
      <button class="filter-btn" data-filter="Especiales">Especiales de la Casa</button>
      <button class="filter-btn" data-filter="Clásicas">Clásicas Reales</button>
      <button class="filter-btn" data-filter="Pollo & Crispy">Pollo Crispy</button>
      <button class="filter-btn" data-filter="Vegetarianas">Vegetarianas</button>
    </div>

    <!-- Burgers Grid -->
    <div class="burgers-grid">
      {burgers.map((burger) => (
        <article class="burger-card" data-category={burger.category}>
          <div class="card-img-wrap">
            <img class="card-img" src={burger.image} alt={burger.name} loading="lazy" />
            <div class="badge-specialty">
              <span>💎</span> {burger.specialtyBadge}
            </div>
            <div class="badge-rating">
              ★ {burger.rating.toFixed(1)}
            </div>
          </div>

          <div class="card-content">
            <span class="card-category">{burger.category}</span>
            <h3 class="card-title">{burger.name}</h3>

            <!-- Specialty Tier Badge -->
            <div
              class="specialty-tier-pill"
              style={`background-color: ${burger.badgeBg}; color: ${burger.badgeColor}; border: 1px solid ${burger.badgeColor}33;`}
            >
              {burger.specialtyLevel}
            </div>

            <p class="card-tagline">{burger.tagline}</p>

            <div class="card-footer">
              <div class="card-price">
                ${burger.price.toFixed(2)}
              </div>
              <button
                class="btn-details"
                data-burger={JSON.stringify(burger)}
              >
                <span>🔍</span> Ver detalles
              </button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Benefits Section -->
  <section id="beneficios" class="benefits-section">
    <div class="benefits-grid">
      <div class="benefit-card">
        <span class="benefit-icon">🥩</span>
        <h4 class="benefit-title">100% Angus Certificado</h4>
        <p class="benefit-text">Carne de pastura seleccionada y picada a diario. Sin aditivos, conservantes ni mezclas industriales.</p>
      </div>
      <div class="benefit-card">
        <span class="benefit-icon">🍞</span>
        <h4 class="benefit-title">Brioche de Mantequilla Francesa</h4>
        <p class="benefit-text">Horneado cada madrugada con fermentación lenta de 18 horas para una textura esponjosa y tostado perfecto.</p>
      </div>
      <div class="benefit-card">
        <span class="benefit-icon">⚡</span>
        <h4 class="benefit-title">Despacho Ultrarrápido</h4>
        <p class="benefit-text">Nuestro empaque isotérmico ecológico conserva la temperatura, crujencia y jugosidad intacta hasta tu mesa.</p>
      </div>
      <div class="benefit-card">
        <span class="benefit-icon">📱</span>
        <h4 class="benefit-title">Simulador de Pedidos PWA</h4>
        <p class="benefit-text">Instala nuestra Progressive Web App y simula pedidos al instante con seguimiento en tiempo real.</p>
      </div>
    </div>
  </section>

  <!-- Ecosystem Cross-link Banner -->
  <section class="banner-ecosystem">
    <div class="ecosystem-box">
      <div>
        <span style="display:inline-block; font-size:0.8rem; font-weight:700; color:#fbbf24; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:0.75rem;">
          Ecosistema Tecnológico Hamburger Rapid
        </span>
        <h3>Experimenta la Plataforma Multi-Capa en Vivo</h3>
        <p>
          Hamburger Rapid no es solo una landing comercial: incluye una <strong>PWA Móvil interactiva</strong> para clientes y un <strong>Panel de Control Administrativo</strong> para gestionar el catálogo y monitorear la base de datos.
        </p>
        <div style="display:flex; gap:1rem; flex-wrap:wrap;">
          <a href="/app" class="btn-primary" style="background:#ffffff; color:#1c1917;">
            📱 Lanzar App Móvil PWA
          </a>
          <a href="/admin" class="btn-outline" style="border-color:rgba(255,255,255,0.3); color:#ffffff; background:transparent;">
            ⚙️ Panel Administrativo
          </a>
        </div>
      </div>

      <div class="ecosystem-links">
        <a href="/app" class="app-link-card">
          <div class="app-link-info">
            <strong>PWA Mobile Client</strong>
            <span>Menú &bull; Ofertas &bull; Órdenes &bull; Perfil</span>
          </div>
          <span style="font-size:1.4rem;">→</span>
        </a>
        <a href="/admin" class="app-link-card">
          <div class="app-link-info">
            <strong>Panel Admin & Métricas</strong>
            <span>Gestor de Hamburguesas & Estado MySQL</span>
          </div>
          <span style="font-size:1.4rem;">→</span>
        </a>
        <a href="/api/health" class="app-link-card" style="opacity: 0.85;">
          <div class="app-link-info">
            <strong>Health Check API REST</strong>
            <span>Monitoreo de latencia y base de datos</span>
          </div>
          <span style="font-size:1.4rem;">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-container">
      <div class="brand-logo">
        <span class="brand-icon">🍔</span>
        <div>
          <span class="brand-name">HAMBURGER <span>RAPID</span></span>
          <span class="brand-sub">Craft Fast-Food Architecture</span>
        </div>
      </div>

      <div style="display:flex; gap:1.5rem; font-size:0.9rem; font-weight:600;">
        <a href="/app" style="color:var(--text-muted); text-decoration:none;">📱 PWA Mobile</a>
        <a href="/admin" style="color:var(--text-muted); text-decoration:none;">⚙️ Panel Admin</a>
        <a href="/api/products" style="color:var(--text-muted); text-decoration:none;">📦 API Productos</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; 2026 Hamburger Rapid &bull; Plataforma Comercial Integrada &bull; Astro + React + Node.js + MySQL
    </div>
  </footer>

  <!-- Details Modal -->
  <div id="detailsModal" class="modal-backdrop">
    <div class="modal-card">
      <button id="closeModalBtn" class="modal-close" aria-label="Cerrar modal">&times;</button>
      <img id="modalImg" class="modal-img" src="" alt="Hamburguesa" />
      <div class="modal-body">
        <span id="modalTier" class="modal-tier">Nivel de Especialidad</span>
        <h3 id="modalTitle" class="modal-title">Nombre de la Hamburguesa</h3>
        <p id="modalDesc" class="modal-desc">Descripción culinaria detallada.</p>

        <div class="modal-ingredients">
          <h4>🥩 Ingredientes Seleccionados</h4>
          <div id="modalIngredientsList" class="ingredients-tags"></div>
        </div>

        <div class="modal-specs">
          <div class="spec-box">
            <div id="modalPrep" class="spec-val">10 min</div>
            <div class="spec-label">Tiempo de Cocción</div>
          </div>
          <div class="spec-box">
            <div id="modalCalories" class="spec-val">750 kcal</div>
            <div class="spec-label">Energía</div>
          </div>
          <div class="spec-box">
            <div id="modalRating" class="spec-val">★ 4.9</div>
            <div class="spec-label">Calificación Gourmet</div>
          </div>
        </div>

        <div class="modal-footer">
          <div>
            <div style="font-size:0.75rem; color:var(--text-muted); text-transform:uppercase; font-weight:700;">Precio Comercial</div>
            <div id="modalPrice" class="modal-price">$0.00</div>
          </div>
          <a href="/app" class="btn-primary" style="padding: 0.8rem 1.6rem;">
            🛒 Simular Compra en PWA
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Client-side Interactive Script -->
  <script is:inline>
    // Filtering logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const filter = btn.getAttribute('data-filter');

        burgerCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Details Logic
    const modal = document.getElementById('detailsModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const detailButtons = document.querySelectorAll('.btn-details');

    const modalImg = document.getElementById('modalImg');
    const modalTier = document.getElementById('modalTier');
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalIngredientsList = document.getElementById('modalIngredientsList');
    const modalPrep = document.getElementById('modalPrep');
    const modalCalories = document.getElementById('modalCalories');
    const modalRating = document.getElementById('modalRating');
    const modalPrice = document.getElementById('modalPrice');

    detailButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const data = JSON.parse(btn.getAttribute('data-burger'));
        modalImg.src = data.image;
        modalImg.alt = data.name;
        modalTier.textContent = data.specialtyLevel;
        modalTier.style.backgroundColor = data.badgeBg || '#fef3c7';
        modalTier.style.color = data.badgeColor || '#b45309';
        modalTitle.textContent = data.name;
        modalDesc.textContent = data.description;
        modalPrep.textContent = data.prepTime || '10 min';
        modalCalories.textContent = data.calories || '750 kcal';
        modalRating.textContent = '★ ' + (data.rating ? data.rating.toFixed(1) : '5.0');
        modalPrice.textContent = '$' + data.price.toFixed(2);

        // Ingredients
        modalIngredientsList.innerHTML = '';
        if (data.ingredients && data.ingredients.length > 0) {
          data.ingredients.forEach(ing => {
            const tag = document.createElement('span');
            tag.className = 'ingredient-tag';
            tag.textContent = ing;
            modalIngredientsList.appendChild(tag);
          });
        }

        modal.classList.add('open');
      });
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('open');
    });

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.remove('open');
      }
    });
  </script>
</body>
</html>
