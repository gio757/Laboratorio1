      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 3rem;
      flex-wrap: wrap;
    }
    .filter-btn {
      padding: 0.65rem 1.4rem;
      background: #181820;
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 9999px;
      font-family: var(--font-display);
      font-size: 1.15rem;
