    .modal-title {
      font-family: var(--font-display);
      font-size: 2.5rem;
      letter-spacing: 0.04em;
      color: #ffffff;
      line-height: 1.1;
      margin-bottom: 0.6rem;
    }
    .modal-desc {
      color: #d1d5db;
      line-height: 1.6;
      font-size: 0.98rem;
      margin-bottom: 1.5rem;
    }
    .modal-ingredients {
      background: #1b1b22;
      border-radius: 14px;
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      border: 1px solid rgba(245, 158, 11, 0.25);
    }
    .modal-ingredients h4 {
      font-family: var(--font-display);
      font-size: 1.15rem;
      letter-spacing: 0.05em;
      color: var(--yellow-bright);
      margin-bottom: 0.75rem;
    }
    .ingredients-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .ingredient-tag {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 0.35rem 0.8rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      color: #f3f4f6;
    }
    .modal-specs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      margin-bottom: 1.75rem;
      text-align: center;
    }
    .spec-box {
      background: #181820;
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 0.85rem;
      border-radius: 12px;
    }
    .spec-val {
      font-family: var(--font-display);
      font-size: 1.5rem;
      color: var(--yellow-bright);
      line-height: 1;
    }
    .spec-label {
      font-size: 0.72rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 0.25rem;
    }
    .modal-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
    .modal-price {
      font-family: var(--font-display);
      font-size: 2.4rem;
      color: #ffffff;
      line-height: 1;
    }
    .modal-price span {
      color: var(--yellow-bright);
    }

    /* Responsive */
    @media (max-width: 980px) {
      .hero-section {
        grid-template-columns: 1fr;
        padding-top: 2rem;
        gap: 2.5rem;
      }
      .delivery-brush-box {
        flex-direction: column;
        text-align: center;
        padding: 2rem 1.5rem;
      }
      .delivery-left-content {
        flex-direction: column;
      }
      .reference-box {
        grid-template-columns: 1fr;
        padding: 1.75rem;
      }
      .ecosystem-container {
        grid-template-columns: 1fr;
        padding: 2rem;
      }
      .nav-links {
        display: none;
      }
    }
  </style>
</head>
