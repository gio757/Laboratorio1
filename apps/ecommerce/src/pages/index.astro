      color: #ffffff;
      font-family: var(--font-display);
      font-size: 1.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 16px rgba(220, 38, 38, 0.5);
      z-index: 5;
      text-shadow: 1px 1px 2px #000;
    }
    .combo-img-wrap {
      height: 220px;
      width: 100%;
      position: relative;
      overflow: hidden;
      background: #1c1c22;
    }
    .combo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }
    .combo-card:hover .combo-img {
      transform: scale(1.08);
    }
    .combo-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex: 1;
      justify-content: space-between;
    }
    .combo-title-bar {
      background: #fbbf24;
      color: #121212;
      font-family: var(--font-display);
      font-size: 1.3rem;
      letter-spacing: 0.04em;
